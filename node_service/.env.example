# Local development defaults for the Node API.
# Copy to .env and adjust credentials.
RETRIEVAL_BACKEND_URL=http://localhost:8000
EVALUATION_BACKEND_URL=http://localhost:8001

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=auto_gen_message

REDIS_HOST=localhost
REDIS_PORT=6379

PORT=3001
NODE_ENV=development

# Set true to exercise the extension/UI without any LLM API key.
ALLOW_MOCK_LLM=false

EVAL_WORKER_CONCURRENCY=1
EVAL_JOB_DELAY_MS=300000
EVAL_BUSY_CHECK_INTERVAL_MS=15000
EVAL_CPU_THRESHOLD=0.75
ONLINE_BUSY_TTL_SECONDS=30
MODEL_SCORE_UPDATE_STRATEGY=global_ema
MODEL_SCORE_EMA_ALPHA=0.1
# Prompt exemplar diff caps (characters). Empty = no limit.
PROMPT_MAX_EXAMPLES_DIFF_CHARS=
PROMPT_MAX_SINGLE_EXAMPLE_DIFF_CHARS=
