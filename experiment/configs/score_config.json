{
  "input_jsonl": "../inputs/aligned/comapre_merged_aligned_945.jsonl",
  "output_jsonl": "../outputs/plugin_comparison/merged_aligned_945_scored.jsonl",
  "score_scale": "0_1",
  "empty_output_strategy": "empty_string",
  "normalize": {
    "unicode_nfkc": true,
    "newline_to_space": true,
    "collapse_whitespace": true,
    "strip": true,
    "lowercase": true
  },
  "bleu": {
    "enabled": true,
    "tokenize": "13a",
    "smooth_method": "exp",
    "smooth_value": null,
    "lowercase": false,
    "use_effective_order": true
  },
  "rouge": {
    "enabled": true,
    "use_stemmer": false
  },
  "meteor": {
    "enabled": true,
    "backend": "nltk"
  },
  "cider": {
    "enabled": true
  },
  "bertscore": {
    "enabled": false
  }
}
