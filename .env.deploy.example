# Prebuilt images (docker-compose.release.yml). Override to use a mirror or a
# pinned digest. The source-build compose (docker-compose.deploy.yml) ignores
# these.
BACKEND_IMAGE=ghcr.io/t-rresa/coracommit-backend:2.1.0
NODE_IMAGE=ghcr.io/t-rresa/coracommit-node:2.1.0

# Base images. Override with a registry mirror on restricted networks, e.g.
# MYSQL_IMAGE=docker.1ms.run/library/mysql:8.0
MYSQL_IMAGE=mysql:8.0
REDIS_IMAGE=redis:7-alpine

# Host ports. Change any of these if the port is already in use (for
# example, a local MySQL on 3306).
RETRIEVAL_PORT=8000
EVALUATION_PORT=8001
NODE_API_PORT=3001
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379

# MySQL
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=auto_gen_message

# Node service database
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me_root_password
DB_NAME=auto_gen_message

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Node API
PORT=3001
NODE_ENV=production
# Set true to exercise the UI without an LLM API key.
ALLOW_MOCK_LLM=false

# Python backends
RETRIEVAL_BACKEND_URL=http://retrieval-backend:8000
EVALUATION_BACKEND_URL=http://evaluation-backend:8001

# Retrieval / Evaluation backend
# Quickstart uses the committed demo resource. Set RESOURCE_DIR=resource
# after building the full ApacheCM corpus.
RESOURCE_DIR=resource_demo
RESOURCE_PATH=/app/resource
EMBEDDING_MODEL=codebert

# Worker tuning
EVAL_WORKER_CONCURRENCY=1
EVAL_JOB_DELAY_MS=300000
EVAL_BUSY_CHECK_INTERVAL_MS=15000
EVAL_CPU_THRESHOLD=0.75
ONLINE_BUSY_TTL_SECONDS=30
MODEL_SCORE_UPDATE_STRATEGY=global_ema
MODEL_SCORE_EMA_ALPHA=0.1

# Prompt exemplar diff caps (characters). Leave empty for no limit.
PROMPT_MAX_EXAMPLES_DIFF_CHARS=
PROMPT_MAX_SINGLE_EXAMPLE_DIFF_CHARS=
